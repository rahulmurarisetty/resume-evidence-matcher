# Copy to .env and adjust. Never commit .env.

APP_ENV=local
LOG_LEVEL=INFO

# SQLite for local work. v1.0 switches this to a managed Postgres URL.
DATABASE_URL=sqlite:///./data/app.db

# Upload limits
MAX_UPLOAD_MB=5
MAX_PDF_PAGES=10
MAX_JD_CHARS=20000

# Stored analyses are deleted after this many hours
RETENTION_HOURS=24

# Comma-separated list of allowed browser origins for the API
CORS_ORIGINS=http://localhost:8501

# Not used until v0.3
ANTHROPIC_API_KEY=
