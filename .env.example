# Copy to .env and adjust. Never commit .env.

# local or production. production refuses unsafe settings (SQLite, AUTH_MODE=disabled,
# unscanned uploads, a database connection without TLS) and adds HSTS.
APP_ENV=local
LOG_LEVEL=INFO

# SQLite for local work. Production uses Postgres through psycopg 3:
# postgresql+psycopg://user:password@host:5432/dbname?sslmode=require
DATABASE_URL=sqlite:///./data/app.db
# Run the migrations at startup. Empty means yes locally and no in production, where
# they run once as a separate step and the app refuses to start while any are pending.
DB_AUTO_MIGRATE=

# Accounts: required, or disabled for a single-user local demo (refused in production)
AUTH_MODE=required
# Hours a login session lasts
SESSION_TTL_HOURS=12

# Upload limits
MAX_UPLOAD_MB=5
MAX_PDF_PAGES=10
MAX_JD_CHARS=20000
MAX_DOCX_UNCOMPRESSED_MB=50

# Stored analyses are deleted after this many hours
RETENTION_HOURS=24

# Comma-separated list of allowed browser origins for the API
CORS_ORIGINS=http://localhost:8501
# Proxies whose X-Forwarded-For header gives the client address, as addresses and
# CIDR ranges. Empty trusts none, so the connecting address is used.
TRUSTED_PROXIES=

# Malware scanning of uploads: off, or clamav to send each upload to clamd first.
# Production refuses off unless ALLOW_UNSCANNED_UPLOADS=true, and then warns at every start.
SCANNER=off
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_SECONDS=30
ALLOW_UNSCANNED_UPLOADS=false

# Rate limits, kept in memory by each API process. Per account (per email for login
# and register), and RATE_LIMIT_IP_MULTIPLIER times as many per client address.
RATE_LIMITS_ENABLED=true
RATE_LIMIT_AUTH=5/minute
RATE_LIMIT_ANALYSES=30/hour
RATE_LIMIT_SUGGESTIONS=30/hour
RATE_LIMIT_EXPORTS=60/hour
RATE_LIMIT_IP_MULTIPLIER=5

# Matching by meaning: off, on or auto. auto turns it on only when the ml extra
# (sentence-transformers) is installed. on stops the app at startup if it isn't.
SEMANTIC_MATCHING=auto
# Resume lines the embedding model passes to the reranker for each requirement
SEMANTIC_TOP_K=8
# Reranker score (0 to 1) a line needs to count as related
SEMANTIC_THRESHOLD=0.5
# Downloaded from Hugging Face on first start, about 180 MB for both
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L6-v2

# docker compose only: build the API image with sentence-transformers and CPU-only PyTorch
INSTALL_ML=false
# docker compose only: the password of the local Postgres container
POSTGRES_PASSWORD=local-only-password

# Claude: off, on or auto. auto turns it on only when ANTHROPIC_API_KEY is set. on
# stops the app at startup without a key. Without Claude the rule-based parser reads
# job descriptions and rewrite suggestions are off; everything else works.
LLM_ENABLED=auto
# Your key goes in your local .env only. .env is in .gitignore and .dockerignore.
# Never put a real key in .env.example, a commit, an issue or a log.
ANTHROPIC_API_KEY=
LLM_PARSE_MODEL=claude-haiku-5-5
LLM_REWRITE_MODEL=claude-sonnet-5-5
# Seconds per attempt. A failed call is retried up to twice.
LLM_TIMEOUT_SECONDS=30
# Rewrite candidates one analysis may ask Claude for, to bound cost
LLM_MAX_SUGGESTIONS=20
