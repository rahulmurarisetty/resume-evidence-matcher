# Copy to .env and adjust. Never commit .env.

APP_ENV=local
LOG_LEVEL=INFO

# SQLite for local work. v1.0 switches this to a managed Postgres URL.
DATABASE_URL=sqlite:///./data/app.db

# Upload limits
MAX_UPLOAD_MB=5
MAX_PDF_PAGES=10
MAX_JD_CHARS=20000

# Stored analyses are deleted after this many hours
RETENTION_HOURS=24

# Comma-separated list of allowed browser origins for the API
CORS_ORIGINS=http://localhost:8501

# Matching by meaning: off, on or auto. auto turns it on only when the ml extra
# (sentence-transformers) is installed. on stops the app at startup if it isn't.
SEMANTIC_MATCHING=auto
# Resume lines the embedding model passes to the reranker for each requirement
SEMANTIC_TOP_K=8
# Reranker score (0 to 1) a line needs to count as related
SEMANTIC_THRESHOLD=0.5
# Downloaded from Hugging Face on first start, about 180 MB for both
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L6-v2

# docker compose only: build the API image with sentence-transformers and CPU-only PyTorch
INSTALL_ML=false

# Claude: off, on or auto. auto turns it on only when ANTHROPIC_API_KEY is set. on
# stops the app at startup without a key. Without Claude the rule-based parser reads
# job descriptions and rewrite suggestions are off; everything else works.
LLM_ENABLED=auto
# Your key goes in your local .env only. .env is in .gitignore and .dockerignore.
# Never put a real key in .env.example, a commit, an issue or a log.
ANTHROPIC_API_KEY=
LLM_PARSE_MODEL=claude-haiku-5-5
LLM_REWRITE_MODEL=claude-sonnet-5-5
# Seconds per attempt. A failed call is retried up to twice.
LLM_TIMEOUT_SECONDS=30
# Rewrite candidates one analysis may ask Claude for, to bound cost
LLM_MAX_SUGGESTIONS=20
